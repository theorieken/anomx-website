{
  "name": "anomx-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/package-static.mjs",
    "start": "ANOMX_NODE_SERVER=1 next start",
    "lint": "eslint .",
    "build:server": "ANOMX_NODE_SERVER=1 next build",
    "deploy": "node scripts/deploy-static.mjs",
    "test:static": "node scripts/test-static.mjs",
    "docs:generate": "python3 scripts/generate-package-docs.py && python3 scripts/generate-agent-catalog.py",
    "docs:check": "python3 scripts/generate-package-docs.py --check && python3 scripts/generate-agent-catalog.py --check",
    "predev": "npm run docs:generate",
    "prebuild": "npm run docs:generate",
    "prebuild:server": "npm run docs:generate",
    "test:docs": "python3 -B scripts/test-package-docs.py && python3 -B scripts/test-agent-catalog.py"
  },
  "dependencies": {
    "mysql2": "^3.22.5",
    "next": "^16.2.4",
    "nodemailer": "^8.0.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "typescript": "^6.0.3"
  }
}
